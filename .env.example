# Optional: LLM query understanding (falls back to rules if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hybrid fusion
SEMANTIC_WEIGHT=0.55
BM25_WEIGHT=0.45

API_HOST=0.0.0.0
API_PORT=8000
